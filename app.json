{
  "name": "COMBINADO",
  "description": "Sou um bot que gerencio grupos, reproduzo músicas, entre outras coisas...",
  "keywords": [
    "musicbot",
    "vcbot",
    "musicplayer"
  ],
  "repository": "https://github.com/zerinhogod/combinado2",
  "logo": "https://envs.sh/9oZ.jpg",
  "stack": "container",
  "env": {
    "API_ID": {
      "description": "Get it from my.telegram.org",
      "value": "28394860",
      "required": true
    },
    "API_HASH": {
      "description": "Get it from my.telegram.org",
      "value": "07b4fad3981e64c0554add6f249f7c07",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Get it from botfather.",
      "required": true
    },
    "STRING_SESSION": {
      "description": "Generate pyrogram v2 string session and paste here.",
      "required": true
    },
    "OWNER_ID": {
      "description": "Provide an user_id to control bot as owner.",
      "required": true
    },
    "LOG_GROUP_ID": {
      "description": "Provide an chat_id for logs.",
      "required": true
    },
    "MONGO_DB_URL": {
      "description": "Paste here your mongodb url.",
      "required": true
    },
    "START_IMAGE_URL": {
      "description": "An image url for your bot.",
      "value": "https://te.legra.ph/file/fe4373a26d55df8ed04e5.png",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "addons": [],
  "buildpacks": [
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg.git"
    },
    {
      "url": "heroku/python"
    }
  ]
}
